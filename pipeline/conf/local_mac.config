// Settings for running nf-core pipelines on the owner's Mac mini (M4, 16 GB) with conda/mamba.
// Resource caps are generated per run (resources.config next to the run): about half the
// physical memory, so the pipeline leaves room for macOS and open apps.
// Conda environments are cached in $NXF_CONDA_CACHEDIR (set by run_study.py to DATA_DIR/conda)
// and reused by every study.

conda {
    // R/Bioconductor environments can take a while to solve and download the first time
    createTimeout = '2 h'
    // Use only the channels each environment file names (conda-forge, bioconda). Without this,
    // mamba also adds the channels from the user's ~/.condarc, which include Anaconda's
    // commercial 'defaults' channel.
    createOptions = '--override-channels'
}

// Delete this run's work/ directory when it succeeds: fetchngs' copy of each download and
// ampliseq's trimmed and filtered reads. A failed run keeps work/ so -resume still works.
cleanup = true

// Cache key = input path + size, not modification time ('lenient'). ampliseq 3.1.0's
// RENAME_RAW_DATA_FILES runs `touch <run>.fastq.gz` when a single-end file already has that name,
// which follows the symlink and changes the raw FASTQ's mtime. With the default key every task of a
// single-end study then missed the cache on -resume (23013615, 2026-11-15: a 70 min rerun to get
// back to the failed step). Inputs are md5-checked on download, so size + path is safe here.
process.cache = 'lenient'

// Record the container of every task, so pipeline_run.json can list the exact images.
trace {
    fields = 'task_id,hash,native_id,name,status,exit,container,submit,duration,realtime,%cpu,peak_rss,rchar,wchar'
}
